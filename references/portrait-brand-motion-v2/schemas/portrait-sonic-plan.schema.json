{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hongrun.local/schemas/portrait-sonic-plan-v1.json",
  "title": "Portrait Sonic Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "brand_profile", "sonic_library", "motion_contract_sha256", "decisions", "policy"],
  "properties": {
    "schema_version": {"const": 1}, "project_id": {"$ref": "#/$defs/id"},
    "brand_profile": {"$ref": "#/$defs/fileRef"}, "sonic_library": {"$ref": "#/$defs/fileRef"}, "motion_contract_sha256": {"$ref": "#/$defs/sha"},
    "decisions": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/cue"}, {"$ref": "#/$defs/silent"}]}},
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["decision_coverage", "cue_coverage_is_adaptive", "speech_is_primary", "actual_mix_required"],
      "properties": {"decision_coverage": {"const": 1.0}, "cue_coverage_is_adaptive": {"const": true}, "speech_is_primary": {"const": true}, "actual_mix_required": {"const": true}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 3}, "sha256": {"$ref": "#/$defs/sha"}}},
    "base": {"type": "object", "required": ["event_id", "recipe_id", "decision"], "properties": {"event_id": {"$ref": "#/$defs/id"}, "recipe_id": {"pattern": "^PBM-0[1-8]$"}, "decision": {"enum": ["cue", "intentionally_silent"]}}},
    "cue": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "additionalProperties": false, "required": ["event_id", "recipe_id", "decision", "motif_family_id", "variant_id", "asset", "rights", "phase", "landing_seconds", "duration_seconds", "gain_db", "pcm_fingerprint"],
         "properties": {
           "event_id": {"$ref": "#/$defs/id"}, "recipe_id": {"pattern": "^PBM-0[1-8]$"}, "decision": {"const": "cue"},
           "motif_family_id": {"pattern": "^PBM-S0[1-5]$"}, "variant_id": {"$ref": "#/$defs/id"}, "asset": {"$ref": "#/$defs/fileRef"}, "rights": {"$ref": "#/$defs/fileRef"},
           "phase": {"enum": ["entrance", "explain", "hold", "exit"]}, "landing_seconds": {"type": "number", "minimum": 0}, "duration_seconds": {"type": "number", "minimum": 0.35, "maximum": 2.2},
           "gain_db": {"type": "number", "minimum": -36, "maximum": 0}, "pcm_fingerprint": {"$ref": "#/$defs/sha"}
         }}
      ]
    },
    "silent": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "additionalProperties": false, "required": ["event_id", "recipe_id", "decision", "reason"],
         "properties": {"event_id": {"$ref": "#/$defs/id"}, "recipe_id": {"pattern": "^PBM-0[1-8]$"}, "decision": {"const": "intentionally_silent"}, "reason": {"type": "string", "minLength": 8}}}
      ]
    }
  }
}
