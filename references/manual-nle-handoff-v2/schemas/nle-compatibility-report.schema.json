{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-preserving-video-editor.local/schemas/nle-compatibility-report-v2.json",
  "title": "NLE compatibility report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "package_profile", "editor", "capabilities",
    "format_results", "human_canary"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["pending", "pass", "failed", "stale"]},
    "package_profile": {"const": "jianying_desktop_compatible_v1"},
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform", "observed_at"],
      "properties": {
        "name": {"enum": ["Jianying Desktop", "CapCut Desktop"]},
        "version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_draft", "api", "cli", "headless_render", "srt_import"],
      "properties": {
        "native_draft": {"const": false},
        "api": {"const": false},
        "cli": {"const": false},
        "headless_render": {"const": false},
        "srt_import": {"type": "boolean"}
      }
    },
    "format_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format_id", "asset_sha256", "imported", "decoded", "editable_class", "finding"],
        "properties": {
          "format_id": {"type": "string", "minLength": 1},
          "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "imported": {"type": "boolean"},
          "decoded": {"type": "boolean"},
          "alpha_preserved": {"type": ["boolean", "null"]},
          "timing_error_frames": {"type": ["number", "null"], "minimum": 0},
          "editable_class": {"enum": ["native_editable", "media_layer_editable", "reference_only", "unavailable"]},
          "finding": {"type": "string", "minLength": 1}
        }
      }
    },
    "human_canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "status", "tasks", "reason"],
      "properties": {
        "actor": {"const": "HongRun"},
        "status": {"enum": ["pending", "pass", "failed"]},
        "tasks": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["task_id", "status"],
            "properties": {
              "task_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["pending", "pass", "failed"]},
              "seconds_spent": {"type": ["number", "null"], "minimum": 0}
            }
          }
        },
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
