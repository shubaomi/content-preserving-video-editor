{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-preserving-video-editor.local/schemas/creative-review-1.0.0.json",
  "title": "Creative Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "project_id", "created_at", "producer", "baseline", "candidate", "input_hashes", "event_comparisons", "automated_status", "multimodal_review", "user_review", "correction_proposals", "status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "review_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "baseline": { "$ref": "#/$defs/mediaArtifact" },
    "candidate": { "$ref": "#/$defs/mediaArtifact" },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motion_design_contract_sha256", "storyboard_sha256", "keyframe_receipts_sha256"],
      "properties": {
        "motion_design_contract_sha256": { "$ref": "#/$defs/sha256" },
        "storyboard_sha256": { "$ref": "#/$defs/sha256" },
        "keyframe_receipts_sha256": { "$ref": "#/$defs/sha256" },
        "motion_audio_decisions_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "event_comparisons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/eventComparison" } },
    "automated_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gate_reports"],
      "properties": {
        "status": { "enum": ["pass", "fail", "action_required"] },
        "gate_reports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "multimodal_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "recommendation", "reasons", "evidence_refs"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "recommendation": { "enum": ["accept", "revise", "reject", "not_run"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "user_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": { "enum": ["pending", "approved", "rejected", "revision_requested", "not_applicable"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "publish_willingness": { "enum": ["yes", "no", "unsure"] },
        "baseline_preference": { "enum": ["baseline", "candidate", "tie"] }
      }
    },
    "correction_proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
    "status": { "enum": ["pending_user_review", "approved", "rejected", "revision_required", "stale"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "purpose"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "pattern": "^(?:[A-Za-z]:\\\\|\\\\\\\\)" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "mediaArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "purpose", "duration_seconds"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "pattern": "^(?:[A-Za-z]:\\\\|\\\\\\\\)" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "purpose": { "type": "string", "minLength": 1 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "eventComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "semantic_event_id", "source_sentence", "viewer_takeaway", "approved_visible_copy", "baseline_timestamp_seconds", "candidate_timestamp_seconds", "phase_artifacts", "target_binding_ids", "audio_auditions"],
      "properties": {
        "event_id": { "$ref": "#/$defs/id" },
        "semantic_event_id": { "$ref": "#/$defs/id" },
        "source_sentence": { "type": "string", "minLength": 1 },
        "viewer_takeaway": { "type": "string", "minLength": 1 },
        "approved_visible_copy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "baseline_timestamp_seconds": { "type": "number", "minimum": 0 },
        "candidate_timestamp_seconds": { "type": "number", "minimum": 0 },
        "phase_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrance", "mid", "pre_exit", "post_exit"],
          "properties": {
            "entrance": { "$ref": "#/$defs/artifact" },
            "mid": { "$ref": "#/$defs/artifact" },
            "pre_exit": { "$ref": "#/$defs/artifact" },
            "post_exit": { "$ref": "#/$defs/artifact" }
          }
        },
        "target_binding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "audio_auditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sfx_off", "sfx_on"],
          "properties": {
            "sfx_off": { "$ref": "#/$defs/artifact" },
            "sfx_on": { "$ref": "#/$defs/artifact" },
            "bgm_off": { "$ref": "#/$defs/artifact" },
            "bgm_on": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "event_id", "selector", "property", "before", "after", "reason", "status"],
      "properties": {
        "proposal_id": { "$ref": "#/$defs/id" },
        "event_id": { "$ref": "#/$defs/id" },
        "selector": { "type": "string", "minLength": 1 },
        "property": { "type": "string", "minLength": 1 },
        "before": {},
        "after": {},
        "reason": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "approved", "rejected", "applied"] }
      }
    }
  }
}
