{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-preserving-video-editor.local/schemas/motion-design-contract-1.0.0.json",
  "title": "Motion Design Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "project_id",
    "created_at",
    "producer",
    "source_media",
    "identity_mode",
    "input_hashes",
    "opportunities",
    "selected_event_ids",
    "constraints"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "contract_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "source_media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "duration_seconds", "width", "height", "orientation", "source_type"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "orientation": { "enum": ["landscape", "portrait", "square", "mixed"] },
        "source_type": { "enum": ["screen_recording", "talking_head", "mixed", "other"] }
      }
    },
    "identity_mode": { "enum": ["self", "third_party", "generic"] },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_brief_sha256", "production_contract_sha256", "evidence_bundle_sha256", "brand_playbook_sha256"],
      "properties": {
        "semantic_brief_sha256": { "$ref": "#/$defs/sha256" },
        "production_contract_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "brand_playbook_sha256": { "$ref": "#/$defs/sha256" },
        "editorial_intent_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/opportunity" }
    },
    "selected_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrent_primary_events", "max_attention_units", "caption_safe_zone", "platform_safe_zone"],
      "properties": {
        "max_concurrent_primary_events": { "type": "integer", "minimum": 1, "maximum": 1 },
        "max_attention_units": { "type": "integer", "minimum": 1, "maximum": 4 },
        "caption_safe_zone": { "$ref": "#/$defs/bbox" },
        "platform_safe_zone": { "$ref": "#/$defs/bbox" },
        "protected_region_binding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^(?:[A-Za-z]:\\\\|\\\\\\\\)" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds"],
      "properties": {
        "start_seconds": { "type": "number", "minimum": 0 },
        "end_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_event_id",
        "decision",
        "rationale",
        "source_window",
        "output_window",
        "transcript_word_ids",
        "approved_visible_copy",
        "viewer_takeaway",
        "evidence_refs"
      ],
      "properties": {
        "semantic_event_id": { "$ref": "#/$defs/id" },
        "decision": { "enum": ["render", "annotation", "caption_only", "reuse_source", "quiet_source", "action_required"] },
        "rationale": { "type": "string", "minLength": 1 },
        "source_window": { "$ref": "#/$defs/window" },
        "output_window": { "$ref": "#/$defs/window" },
        "transcript_word_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "approved_visible_copy": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "viewer_takeaway": { "type": "string", "minLength": 1 },
        "semantic_role": { "enum": ["mark", "explain", "relate", "sequence", "prove", "resolve", "transition"] },
        "recipe_id": { "$ref": "#/$defs/id" },
        "target_binding_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "audio_decision_id": { "$ref": "#/$defs/id" },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "estimated_cost_tier": { "enum": ["low", "medium", "high"] }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "render" } }, "required": ["decision"] },
          "then": { "required": ["semantic_role", "recipe_id", "audio_decision_id"] },
          "else": {
            "not": { "anyOf": [
              { "required": ["recipe_id"] },
              { "required": ["audio_decision_id"] }
            ] }
          }
        }
      ]
    }
  }
}
